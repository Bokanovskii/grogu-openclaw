{
  "id": "grogu-coordination",
  "name": "Grogu shared policy",
  "description": "Shared assistant policy, bounded job observations and native Main coordination.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agentIds", "jobs"],
    "properties": {
      "agentIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "jobs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "agentId", "label", "role"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9_-]+$"},
            "agentId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9_-]+$"},
            "label": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\r\\n]+$"},
            "role": {
              "enum": ["intake", "personal", "financial", "purchase-watch", "research", "review", "reminder"]
            },
            "sourceSessionKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-zA-Z0-9:_-]+$"}
          }
        }
      }
    }
  }
}
