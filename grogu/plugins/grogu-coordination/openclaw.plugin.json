{
  "id": "grogu-coordination",
  "name": "Grogu shared policy",
  "description": "Stable shared instructions and one Main text coordinator.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agentIds", "jobs"],
    "properties": {
      "quietHours": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "timeZone"],
        "properties": {
          "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
          "timeZone": {"type": "string", "minLength": 1, "maxLength": 100}
        }
      },
      "mainAgentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "agentIds": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      },
      "jobs": {
        "type": "array",
        "minItems": 0,
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "agentId", "label", "role"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9_-]+$"},
            "agentId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z0-9_-]+$"},
            "label": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\r\\n]+$"},
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "sourceSessionKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-zA-Z0-9:_-]+$"}
          }
        }
      }
    }
  }
}
